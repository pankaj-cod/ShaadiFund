# Copy to .env.local and fill in. Never commit real values.

# Public URL of the app, no trailing slash. On Vercel it defaults to the production domain.
APP_URL=http://localhost:3000

# Postgres. Locally this matches docker-compose.yml.
# In production use the pooled connection string here.
DATABASE_URL=postgresql://vowfund:vowfund@localhost:54329/vowfund
# Optional: direct (unpooled) connection used only for migrations.
# Neon's Vercel integration provides DATABASE_URL_UNPOOLED, which is used automatically.
# DIRECT_URL=

# Payments: mock | test | live  (see docs/adr/0003-payment-architecture.md)
#   mock  no provider, used by tests and local development
#   test  Razorpay test keys (rzp_test_...), no real money
#   live  Razorpay live keys (rzp_live_...), refused unless LIVE_SETTLEMENT_APPROVED=true
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LIVE_SETTLEMENT_APPROVED=false

# Sign-in. Generate the secret with: openssl rand -base64 36
BETTER_AUTH_SECRET=
# Optional: Google sign-in appears only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: file | resend
#   file    writes each email to .data/outbox as JSON (development and tests only)
#   resend  sends through Resend; requires RESEND_API_KEY and a verified EMAIL_FROM domain
EMAIL_TRANSPORT=file
EMAIL_FROM=ShaadiFund <hello@shaadifund.test>
RESEND_API_KEY=

# Media: local | blob
#   local  images on this machine's disk (development and tests only)
#   blob   Vercel Blob. Connecting a Blob store in Vercel sets BLOB_READ_WRITE_TOKEN for you.
MEDIA_STORAGE=local
BLOB_READ_WRITE_TOKEN=

# Shared rate limits. Optional locally; required on Vercel.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduled jobs (email retries, reconciliation) call /api/internal/cron/* with this bearer token.
# Generate with: openssl rand -base64 36
CRON_SECRET=
